<definitions id="main" name="main" namespace="urn:arbiter:test:main">
  <import namespace="urn:arbiter:test:library" name="lib"
    importType="https://www.omg.org/spec/DMN/20230324/MODEL/"/>
  <inputData id="person" name="Person Input">
    <variable name="Person Input" typeRef="lib.Person"/>
  </inputData>
  <decision id="message" name="Message">
    <informationRequirement><requiredInput href="urn:arbiter:test:main#person"/></informationRequirement>
    <knowledgeRequirement><requiredKnowledge href="urn:arbiter:test:library#greet"/></knowledgeRequirement>
    <literalExpression><text>lib.greet(Person Input)</text></literalExpression>
  </decision>
</definitions>
