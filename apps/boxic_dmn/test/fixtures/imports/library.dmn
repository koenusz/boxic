<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/"
  id="library" name="library" namespace="urn:boxic:test:library">
  <itemDefinition name="Person">
    <itemComponent name="name"><typeRef>string</typeRef></itemComponent>
  </itemDefinition>
  <businessKnowledgeModel id="greet" name="greet">
    <variable name="greet"/>
    <encapsulatedLogic>
      <formalParameter name="person" typeRef="Person"/>
      <literalExpression><text>"Hello " + person.name</text></literalExpression>
    </encapsulatedLogic>
  </businessKnowledgeModel>
</definitions>
