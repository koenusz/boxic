# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Generated DMN TCK compatibility reports. Published baselines should live in
# a separate, explicitly tracked directory.
/artifacts/*.csv
/artifacts/*.json

# Compatibility keeps compact JSON regression baselines. Full per-case CSV
# exports and writer audit dumps are generated evidence, not source fixtures.
/compatibility/*.csv
/compatibility/writer-audit-*.json

# Boxic vendors the official TCK input corpus, not the upstream website,
# historical vendor results, Java runners, examples, or repository tooling.
# Keep vendor/dmn-tck/TestCases, its schemas, license, README, PINNED_COMMIT,
# and UPSTREAM_REPO trackable.
/vendor/dmn-tck/.github/
/vendor/dmn-tck/TestExamples/
/vendor/dmn-tck/TestResults/
/vendor/dmn-tck/docs/
/vendor/dmn-tck/runners/
/vendor/dmn-tck/utils/
